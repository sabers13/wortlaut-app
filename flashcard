#!/usr/bin/env python3
"""Compatibility alias for the ``./wortlaut`` launcher.

This product was renamed to Wortlaut. ``./flashcard`` is kept as a
legacy compatibility command so existing muscle memory, scripts, and
documentation that still invoke it keep working. It duplicates none of
the launcher logic: it simply re-executes the canonical ``./wortlaut``
script in this same directory with the exact arguments it was given.
New documentation and workflows should use ``./wortlaut`` directly.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> None:
    wortlaut = Path(__file__).resolve().parent / "wortlaut"
    if not wortlaut.is_file():
        sys.stderr.write(
            f"flashcard: the canonical launcher is missing at {wortlaut}\n"
        )
        raise SystemExit(1)
    os.execv(str(wortlaut), [str(wortlaut), *sys.argv[1:]])


if __name__ == "__main__":
    main()
